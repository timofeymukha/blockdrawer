+def band_row() -> MeshModel:
+    """A wall 5 long under a band 0.15 high, a wall at its left end and a
+    skewed core above: the band's long sides (along the wall) would take
+    different along-wall series and shear the band's cells."""
+    points = {"a0": (0.0, 0.0), "a1": (5.0, 0.0), "c0": (0.0, 0.15), "c1": (5.0, 0.15),
+              "d0": (0.0, 1.0), "d1": (4.0, 1.0)}
+    quads = [("a0", "a1", "c1", "c0"), ("c0", "c1", "d1", "d0")]
+    model = _blocks(points, quads, ["a0-a1", "a0-c0", "c0-d0"])
+    return apply_commands(model, ["set_export_settings z_min_patch_type=empty z_max_patch_type=empty"]).model
+
+
+class FieldPassTests(unittest.TestCase):
+    OPTIONS = dict(first_width=0.002, core_size=0.08, growth=1.15, wall_aspect=25.0)
+
+    def _sized(self, **patches):
+        from unittest import mock
+
+        from blockdrawer import size as size_module
+
+        model = band_row()
+        with mock.patch.multiple(size_module, FIELD_GAIN=size_module.FIELD_GAIN, **patches):
+            result = size_model(model, SizeOptions(**self.OPTIONS))
+        return model, result
+
+    def test_a_strip_that_buys_nothing_keeps_one_ratio(self) -> None:
+        import math
+
+        def logs(model):
+            # The band's long sides in one direction (a0 -> a1, c0 -> c1).
+            return [math.log(model.edge_total_expansion(edge_key(*pair))) * (1 if pair[0] < pair[1] else -1)
+                    for pair in (("a0", "a1"), ("c0", "c1"))]
+
+        sheared, old = self._sized(FIELD_BUYS=False)
+        kept, new = self._sized()
+        wall, front = logs(sheared)
+        self.assertGreater(abs(wall - front), 0.05)
+        wall, front = logs(kept)
+        self.assertAlmostEqual(wall, front, places=9)
+        self.assertGreaterEqual(new.field_grading["kept_shared_buying_nothing"], 1)
+        # The wall spokes still get the first width asked.
+        from blockdrawer.quality import wall_first_widths
+
+        (band,) = [item for item in wall_first_widths(kept) if item["spokes"]]
+        low, high = band["first_width"]
+        self.assertLess(max(abs(low / 0.002 - 1), abs(high / 0.002 - 1)), 0.02)
+
+    def _with_verify(self, change, **patches):
+        """Size the band row with ``_verify`` changed by ``change(look,
+        blocks, summary)`` on the field pass's looks only (look 0: the pass,
+        1: the spent state, 2...: the pass after each undo)."""
+        from unittest import mock
+
+        from blockdrawer import size as size_module
+
+        real_verify, real_pass = size_module._verify, size_module._field_pass
+        looks = []
+
+        def verify(model, neighbours):
+            blocks, summary = real_verify(model, neighbours)
+            if looks:
+                look = looks[0]
+                looks[0] += 1
+                return change(look, blocks, summary)
+            return blocks, summary
+
+        def field_pass(working, state, options):
+            looks.append(0)
+            try:
+                return real_pass(working, state, options)
+            finally:
+                looks.clear()
+
+        with mock.patch.object(size_module, "_verify", side_effect=verify), \
+                mock.patch.object(size_module, "_field_pass", side_effect=field_pass), \
+                mock.patch.multiple(size_module, FIELD_BUYS=False, **patches):
+            return size_model(band_row(), SizeOptions(**self.OPTIONS))
+
+    def test_a_pass_worse_in_one_block_is_undone_there_only(self) -> None:
+        def change(look, blocks, summary):
+            # The first look at the pass finds b1 worse; once its strips are
+            # back on their shared ratios the pass holds.
+            if look == 0:
+                blocks = {**blocks, "b1": {**blocks["b1"], "severe_faces": blocks["b1"]["severe_faces"] + 1}}
+                summary = {**summary, "severe_faces": summary["severe_faces"] + 1}
+            return blocks, summary
+
+        record = self._with_verify(change).field_grading
+        self.assertNotIn("dropped", record)
+        self.assertGreaterEqual(record["undone_strips"], 1)
