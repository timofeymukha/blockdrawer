+def long_row() -> MeshModel:
+    """One block 20 long and 1 high with a wall at its left end: the long
+    sides grow from the wall's first width and level off at the core size,
+    which one geometric series per edge cannot follow."""
+    points = {"a0": (0.0, 0.0), "a1": (20.0, 0.0), "b1": (20.0, 1.0), "b0": (0.0, 1.0)}
+    return _blocks(points, [("a0", "a1", "b1", "b0")], ["a0-b0"])
+
+
+class FitSplitTests(unittest.TestCase):
+    OPTIONS = dict(first_width=0.001, core_size=0.2, growth=1.2)
+
+    def test_a_strip_one_series_cannot_follow_is_cut(self) -> None:
+        plain = long_row()
+        off = size_model(plain, SizeOptions(**self.OPTIONS, fit_split=0.0))
+        self.assertEqual(off.splits, [])
+        cut = long_row()
+        on = size_model(cut, SizeOptions(**self.OPTIONS))
+        rules = [item["rule"] for item in on.splits]
+        self.assertIn("fit", rules)
+        self.assertEqual(len(cut.blocks), 1 + rules.count("fit") + rules.count("two-ended"))
+        # The cut row needs far fewer cells than one series over 20.
+        self.assertLess(on.field_cells, 0.5 * off.field_cells)
+        self.assertLess(on.total_cells, 0.5 * off.total_cells)
+        self.assertEqual(on.jumps.get("above_2_5", 0), 0)
+        # Each split names its new vertices and blocks, as the two-ended ones do.
+        for item in on.splits:
+            self.assertTrue(item["new_vertices"] and item["new_blocks"])
+
+    def test_the_option_and_its_check(self) -> None:
+        from blockdrawer.size import FIT_SPLIT_RATIO
+
+        self.assertGreater(FIT_SPLIT_RATIO, 1.0)
+        default = apply_commands(long_row(), ["size 0.001 0.2 growth=1.2"])
+        named = apply_commands(long_row(), [f"size 0.001 0.2 growth=1.2 fit_split={FIT_SPLIT_RATIO}"])
+        self.assertEqual(to_data(default.model), to_data(named.model))
+        off = apply_commands(long_row(), ["size 0.001 0.2 growth=1.2 fit_split=0"])
+        self.assertEqual(off.results[0].result["splits"], [])
+        for bad in (-1.0, 0.5, 1.0):
+            with self.assertRaises(TopologyError):
+                size_model(long_row(), SizeOptions(**self.OPTIONS, fit_split=bad))
