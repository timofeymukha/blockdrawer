+def _component_orientation(model: MeshModel, members) -> dict[EdgeKey, str]:
+    """Each member's begin vertex, carried through the blocks (a side's end
+    faces the corner across the block) and across cyclic pairs: the
+    direction ``split_edge`` cuts the component in, with no length filter."""
+    inside = set(members)
+    pairs: dict[tuple[EdgeKey, str], list[tuple[EdgeKey, str]]] = {}
+    for block in model.blocks:
+        keys = [edge_key(*block.directed_edge(index)) for index in range(4)]
+        corners = block.vertices
+        for k in range(2):
+            first, second = keys[k], keys[k + 2]
+            if first not in inside:
+                continue
+            for here, there in ((corners[k], corners[(k + 3) % 4]),
+                                (corners[(k + 1) % 4], corners[(k + 2) % 4])):
+                pairs.setdefault((first, here), []).append((second, there))
+                pairs.setdefault((second, there), []).append((first, here))
+    seed = min(members)
+    orientation = {seed: seed[0]}
+    stack = [seed]
+    while stack:
+        current = stack.pop()
+        begin = orientation[current]
+        end = current[0] if current[1] == begin else current[1]
+        for vertex, keeps in ((begin, True), (end, False)):
+            for other, other_vertex in pairs.get((current, vertex), ()):
+                if other in orientation:
+                    continue
+                other_end = other[0] if other[1] == other_vertex else other[1]
+                orientation[other] = other_vertex if keeps else other_end
+                stack.append(other)
+    return orientation
+
+
+def _piece_count(length: float, start: float, end: float, options: SizeOptions) -> int:
+    """Fewest cells of one geometric series within end widths ``start`` and
+    ``end`` over ``length``, growing at most ``growth`` from cell to cell."""
+    if length <= 0.0:
+        return 1
+    cells = _fit_count(length, end / start, start, end, options.maximum_cells)
+    ratio = max(start, end) / min(start, end)
+    if ratio > 1.0:
+        cells = max(cells, 1 + math.ceil(math.log(ratio) / math.log(options.growth) - 1.0e-9))
+    return min(cells, options.maximum_cells)
+
+
+def _fit_cuts(model, edges, bounds, components, needed, two_ended, options) -> dict[EdgeKey, tuple[float, float]]:
+    """Strips one geometric series cannot follow: per count component, the
+    member whose series sets the count (``_strip_targets``) against the best
+    single split of the component - over cut positions along that member,
+    every member cut at the same fraction of its length (in the direction
+    the cut runs through the blocks) into two series, each within its end
+    bounds and the width the profile wants at the cut, the count per side
+    the largest any member needs. A component whose fit needs more than
+    ``fit_split`` times that is cut there: ``{member: (fraction, ratio)}``
+    in the member's canonical direction. One series per edge cannot grow
+    from a wall's first width and then level off at the core size (a wake
+    row 19 long needed 280 cells where its profile asks 80), nor follow a
+    profile fine at both ends below ``SPLIT_RATIO``. Components holding a
+    cyclic edge are left out: ``_split_strips`` would refuse them."""
+    cyclic = {edge for match in _cyclic_matches(model) for edge in (match.first, match.second)}
+    slope = options.growth - 1.0
+    found: dict[EdgeKey, tuple[float, float]] = {}
+    for members in components:
+        if any(member in cyclic for member in members):
+            continue
+        candidates = [member for member in members if member not in two_ended]
+        if not candidates:
+            continue
+        setter = max(candidates, key=lambda member: (needed[member], member))
+        fit = needed[setter]
+        profiles = {}
+        demand = 0.0
+        for member in members:
+            item = edges[member]
+            profiles[member] = _profile(
+                item, bounds[(member, member[0])], bounds[(member, member[1])], slope, options.core_size)
+            demand = max(demand, _demand(item, profiles[member]))
+        # A split needs at least about the profile's own demand.
+        if fit <= options.fit_split * max(1.0, demand):
+            continue
+        orientation = _component_orientation(model, members)
+        item = edges[setter]
+        total = item.arc[-1]
+        indices = [index for index, s in enumerate(item.arc) if 0.05 < s / total < 0.95]
+        if len(indices) > FIT_CUT_SAMPLES:
+            step = len(indices) / FIT_CUT_SAMPLES
+            indices = [indices[int(k * step)] for k in range(FIT_CUT_SAMPLES)]
+        setter_forward = orientation[setter] == setter[0]
+        best = None
+        for index in indices:
+            canonical = item.arc[index] / total
+            along = canonical if setter_forward else 1.0 - canonical
+            before = after = 0
+            for member in members:
+                sample = edges[member]
+                length = sample.arc[-1]
+                forward = orientation[member] == member[0]
+                position = (along if forward else 1.0 - along) * length
+                nearest = min(range(len(sample.arc)), key=lambda k: abs(sample.arc[k] - position))
+                width = profiles[member][nearest]
+                first = _piece_count(position, bounds[(member, member[0])], width, options)
+                second = _piece_count(length - position, width, bounds[(member, member[1])], options)
+                if not forward:
+                    first, second = second, first
+                before, after = max(before, first), max(after, second)
+            cells = before + after
+            if best is None or cells < best[0]:
+                best = (cells, canonical)
+        if best is not None and fit > options.fit_split * best[0]:
+            found[setter] = (best[1], fit / best[0])
+    return found
+
